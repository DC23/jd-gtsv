<div class="gtsv-oracle">
    <p class="gtsv-oracle-title">{{localize title}}</p>
    {{#if question}}<p class="gtsv-oracle-question"><em>{{question}}</em></p>{{/if}}
    <p class="gtsv-oracle-odds">{{localize odds}}</p>
    <hr class="gtsv-divider">
    <p class="gtsv-oracle-result">{{result}}</p>
    {{#if isRandomEvent}}<p class="gtsv-notable-outcome">{{localize 'GTSV.Oracle.Twist.RandomEvent'}}</p>{{/if}}
</div>
