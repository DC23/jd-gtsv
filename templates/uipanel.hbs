{{log this}}
<div class="standard-form flexcol">
    <div class="button-container flexrow fancy-buttons">
        <span class="hovertext noflex" data-hover="{{localize 'GTSV.ChaosDown'}}">
            <i id="btn-gtsv-chaos-down" data-action="chaos-step" data-direction="down" class="fa-solid fa-down-long">
            </i>
        </span>

        <select name="chaos-factor">
            {{#each chaosFactors.choices}}
            <option value="{{this.die}}">{{localize this.key}} ({{this.die}})</option>
            {{/each}}
        </select>

        <span class="hovertext noflex hovertext-flip" data-hover="{{localize 'GTSV.ChaosUp'}}">
            <i id="btn-gtsv-chaos-up" data-action="chaos-step" data-direction="up" class="fa-solid fa-up-long"> </i>
        </span>
    </div>

    <button data-action="test-scene">{{localize 'GTSV.TestScene'}}</button>
    <button>Ask the Oracle</button>
</div>